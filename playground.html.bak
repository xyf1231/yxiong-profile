<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Letters Playground</title>
  <script type="importmap">
  {
    "imports": {
      "react": "https://esm.sh/react@19.2.7",
      "react-dom/client": "https://esm.sh/react-dom@19.2.7/client",
      "framer-motion": "https://esm.sh/framer-motion@12.42.2",
      "framer-motion/": "https://esm.sh/framer-motion@12.42.2/",
      "@kumailnanji/letters": "https://esm.sh/@kumailnanji/letters@0.1.1"
    }
  }
  </script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background: #0a0a0f;
      color: #e4e4e7;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    header {
      padding: 20px 24px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    header h1 {
      font-size: 1.25rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      background: linear-gradient(90deg, #a855f7, #6366f1);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    header a {
      color: #a1a1aa;
      text-decoration: none;
      font-size: 0.875rem;
      transition: color 0.2s;
    }
    header a:hover { color: #fff; }
    
    .main {
      flex: 1;
      display: flex;
      flex-direction: column;
      max-width: 960px;
      width: 100%;
      margin: 0 auto;
      padding: 48px 32px;
      gap: 36px;
    }
    
    .controls {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 16px;
      padding: 20px;
    }
    .control-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .control-group label {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #a1a1aa;
    }
    .control-group input[type="text"] {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 10px;
      padding: 10px 14px;
      color: #fff;
      font-size: 0.95rem;
      outline: none;
      transition: border-color 0.2s;
    }
    .control-group input[type="text"]:focus {
      border-color: #a855f7;
    }
    .control-group input[type="range"] {
      -webkit-appearance: none;
      width: 100%;
      height: 6px;
      border-radius: 3px;
      background: rgba(255,255,255,0.08);
      outline: none;
    }
    .control-group input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #a855f7;
      cursor: pointer;
      border: 2px solid #0a0a0f;
    }
    .control-group input[type="color"] {
      -webkit-appearance: none;
      width: 100%;
      height: 40px;
      border: none;
      border-radius: 10px;
      background: transparent;
      cursor: pointer;
    }
    .control-group input[type="color"]::-webkit-color-swatch-wrapper {
      padding: 0;
      border-radius: 10px;
    }
    .control-group input[type="color"]::-webkit-color-swatch {
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 10px;
    }
    .range-value {
      font-size: 0.85rem;
      color: #d4d4d8;
      font-variant-numeric: tabular-nums;
    }
    .checkbox-row {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.875rem;
      color: #d4d4d8;
      cursor: pointer;
    }
    .checkbox-row input[type="checkbox"] {
      width: 18px;
      height: 18px;
      accent-color: #a855f7;
    }
    
    .preview {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 340px;
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 16px;
      position: relative;
      overflow: hidden;
      margin-bottom: 24px;
    }
    .preview::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 20% 30%, rgba(124, 58, 237, 0.15), transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(99, 102, 241, 0.12), transparent 50%);
      pointer-events: none;
    }
    .preview-content {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 640px;
      padding: 40px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
    }
    .preview-svg-wrap {
      width: 100%;
      height: 200px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .preview-svg-wrap svg {
      width: 100%;
      height: 100%;
    }
    
    .actions {
      display: flex;
      gap: 12px;
      margin-top: 8px;
    }
    button {
      background: rgba(168, 85, 247, 0.15);
      border: 1px solid rgba(168, 85, 247, 0.3);
      color: #c4b5fd;
      padding: 10px 20px;
      border-radius: 10px;
      font-size: 0.875rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      font-family: inherit;
    }
    button:hover {
      background: rgba(168, 85, 247, 0.25);
      border-color: rgba(168, 85, 247, 0.5);
      color: #fff;
    }
    button.primary {
      background: linear-gradient(135deg, #a855f7, #6366f1);
      border: none;
      color: #fff;
    }
    button.primary:hover {
      opacity: 0.9;
    }
    
    .info {
      font-size: 0.75rem;
      color: #71717a;
      text-align: center;
      margin-top: 8px;
    }
    
    .export-section {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 16px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      margin-top: 16px;
    }
    .export-section h2 {
      font-size: 1rem;
      font-weight: 600;
      color: #e4e4e7;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .export-section h2::before {
      content: "";
      display: inline-block;
      width: 4px;
      height: 18px;
      background: linear-gradient(180deg, #a855f7, #6366f1);
      border-radius: 2px;
    }
    .export-tabs {
      display: flex;
      gap: 8px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      padding-bottom: 8px;
    }
    .export-tab {
      background: transparent;
      border: none;
      color: #a1a1aa;
      padding: 6px 14px;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      font-family: inherit;
    }
    .export-tab:hover {
      color: #fff;
      background: rgba(255,255,255,0.04);
    }
    .export-tab.active {
      color: #fff;
      background: rgba(168, 85, 247, 0.15);
    }
    .export-panel {
      display: none;
    }
    .export-panel.active {
      display: block;
    }
    .code-block {
      background: rgba(0,0,0,0.35);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 12px;
      padding: 16px;
      font-family: 'SF Mono', 'Fira Code', 'JetBrains Mono', Menlo, Monaco, Consolas, monospace;
      font-size: 0.82rem;
      line-height: 1.6;
      color: #c4c4c8;
      overflow-x: auto;
      white-space: pre-wrap;
      word-break: break-all;
      position: relative;
    }
    .code-block .comment { color: #6a6a6e; }
    .code-block .keyword { color: #c678dd; }
    .code-block .string { color: #98c379; }
    .code-block .number { color: #d19a66; }
    .code-block .tag { color: #e06c75; }
    .code-block .attr { color: #d19a66; }
    .copy-btn {
      position: absolute;
      top: 10px;
      right: 10px;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.12);
      color: #a1a1aa;
      padding: 5px 12px;
      border-radius: 6px;
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      font-family: inherit;
    }
    .copy-btn:hover {
      background: rgba(255,255,255,0.12);
      color: #fff;
    }
    .copy-btn.copied {
      background: rgba(39, 174, 96, 0.2);
      border-color: rgba(39, 174, 96, 0.4);
      color: #2ecc71;
    }
    .export-tip {
      font-size: 0.8rem;
      color: #a1a1aa;
      line-height: 1.5;
    }
    .export-tip code {
      background: rgba(255,255,255,0.06);
      padding: 2px 6px;
      border-radius: 4px;
      font-family: 'SF Mono', 'Fira Code', monospace;
      font-size: 0.8rem;
      color: #d4d4d8;
    }
    
    .variant-select, .mode-select {
      display: flex;
      gap: 8px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 10px;
      padding: 4px;
    }
    .variant-select button, .mode-select button {
      flex: 1;
      padding: 8px 14px;
      border-radius: 8px;
      border: none;
      background: transparent;
      color: #a1a1aa;
      font-size: 0.8rem;
    }
    .variant-select button.active, .mode-select button.active {
      background: rgba(168, 85, 247, 0.2);
      color: #fff;
    }

    .gradient-presets {
      display: grid;
      grid-template-columns: repeat(8, 1fr);
      gap: 10px;
      margin-top: 4px;
    }
    .gradient-preset {
      height: 32px;
      border-radius: 8px;
      border: 2px solid transparent;
      cursor: pointer;
      transition: transform 0.15s, border-color 0.15s, box-shadow 0.15s;
    }
    .gradient-preset:hover {
      transform: scale(1.08);
      box-shadow: 0 0 12px rgba(168, 85, 247, 0.3);
    }
    .gradient-preset.active {
      border-color: #fff;
      box-shadow: 0 0 0 2px rgba(168, 85, 247, 0.5), 0 0 16px rgba(168, 85, 247, 0.2);
    }
    #solidColorWrap { display: flex; }
    #gradientPresetsWrap { display: none; }
    #gradientPresetsWrap.show { display: flex; }

    .custom-gradient-controls {
      display: none;
      flex-direction: column;
      gap: 12px;
      margin-top: 8px;
      padding: 12px;
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 10px;
    }
    .custom-gradient-controls.show {
      display: flex;
    }
    .custom-gradient-row {
      display: flex;
      gap: 12px;
      align-items: center;
    }
    .custom-gradient-row .color-input-wrap {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .custom-gradient-row .color-input-wrap label {
      font-size: 0.7rem;
      color: #a1a1aa;
    }
    .custom-gradient-row .color-input-wrap input[type="color"] {
      height: 36px;
      border-radius: 8px;
    }

    .gradient-type-select {
      display: flex;
      gap: 8px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 10px;
      padding: 4px;
    }
    .gradient-type-select button {
      flex: 1;
      padding: 8px 12px;
      border-radius: 8px;
      border: none;
      background: transparent;
      color: #a1a1aa;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      font-family: inherit;
    }
    .gradient-type-select button.active {
      background: rgba(168, 85, 247, 0.2);
      color: #fff;
    }
  </style>
</head>
<body>
  <header>
    <h1>Letters Playground</h1>
    <a href="https://github.com/kumailnanji/letters" target="_blank">GitHub ↗</a>
  </header>
  
  <div class="main">
    <div class="controls">
      <div class="control-group" style="grid-column: 1 / -1;">
        <label>Text</label>
        <input type="text" id="textInput" value="Hello" placeholder="输入文字...">
      </div>
      
      <div class="control-group">
        <label>Variant</label>
        <div class="variant-select" id="variantSelect">
          <button class="active" data-variant="simple">Simple</button>
          <button data-variant="complex">Complex</button>
        </div>
      </div>
      
      <div class="control-group">
        <label>Color Mode</label>
        <div class="mode-select" id="modeSelect">
          <button class="active" data-mode="solid">Solid</button>
          <button data-mode="rainbow">Rainbow</button>
          <button data-mode="sunset">Sunset</button>
          <button data-mode="ocean">Ocean</button>
          <button data-mode="fire">Fire</button>
          <button data-mode="custom">Custom</button>
        </div>
      </div>
      
      <div class="control-group" id="solidColorWrap">
        <label>Solid Color</label>
        <input type="color" id="colorInput" value="#ffffff">
      </div>
      
      <div class="control-group" id="gradientPresetsWrap" style="display:none">
        <label>Gradient Preset</label>
        <div class="gradient-presets" id="gradientPresets">
          <div class="gradient-preset active" data-preset="rainbow" style="background: linear-gradient(90deg, #ff0000, #ff7f00, #ffff00, #00ff00, #0000ff, #4b0082, #9400d3);"></div>
          <div class="gradient-preset" data-preset="sunset" style="background: linear-gradient(90deg, #ff6b6b, #feca57, #ff9ff3, #54a0ff);"></div>
          <div class="gradient-preset" data-preset="ocean" style="background: linear-gradient(90deg, #00d2d3, #5f27cd, #341f97);"></div>
          <div class="gradient-preset" data-preset="fire" style="background: linear-gradient(90deg, #ff9f43, #ee5a24, #c44569);"></div>
          <div class="gradient-preset" data-preset="neon" style="background: linear-gradient(90deg, #39ff14, #00ffff, #ff00ff);"></div>
          <div class="gradient-preset" data-preset="gold" style="background: linear-gradient(90deg, #f39c12, #f1c40f, #e67e22);"></div>
          <div class="gradient-preset" data-preset="aurora" style="background: linear-gradient(90deg, #00b894, #0984e3, #6c5ce7, #fd79a8, #ffeaa7);"></div>
          <div class="gradient-preset" data-preset="berry" style="background: linear-gradient(90deg, #e84393, #a29bfe, #74b9ff);"></div>
          <div class="gradient-preset" data-preset="forest" style="background: linear-gradient(90deg, #2ecc71, #1abc9c, #3498db);"></div>
          <div class="gradient-preset" data-preset="candy" style="background: linear-gradient(90deg, #ff9ff3, #f368e0, #ff6b6b, #feca57);"></div>
          <div class="gradient-preset" data-preset="midnight" style="background: linear-gradient(90deg, #2c3e50, #34495e, #8e44ad);"></div>
          <div class="gradient-preset" data-preset="cherry" style="background: linear-gradient(90deg, #eb4d4b, #f9ca24, #f0932b);"></div>
          <div class="gradient-preset" data-preset="cyan" style="background: linear-gradient(170deg, #00ffff, #00cccc);"></div>
          <div class="gradient-preset" data-preset="magenta" style="background: linear-gradient(170deg, #ff00ff, #cc00cc);"></div>
          <div class="gradient-preset" data-preset="lime" style="background: linear-gradient(170deg, #39ff14, #2ecc71);"></div>
          <div class="gradient-preset" data-preset="violet" style="background: linear-gradient(170deg, #8e44ad, #9b59b6);"></div>
        </div>
      </div>
      
      <div class="control-group" id="customGradientWrap" style="display:none">
        <label>Custom Gradient</label>
        <div class="gradient-type-select" id="gradientTypeSelect">
          <button class="active" data-type="linear">Linear</button>
          <button data-type="radial">Radial</button>
        </div>
        <div class="custom-gradient-controls show" id="customGradientControls">
          <div class="custom-gradient-row">
            <div class="color-input-wrap">
              <label>Start Color</label>
              <input type="color" id="customColor1" value="#00ffff">
            </div>
            <div class="color-input-wrap">
              <label>End Color</label>
              <input type="color" id="customColor2" value="#00cccc">
            </div>
          </div>
          <div class="custom-gradient-row" id="angleRow">
            <label>Angle <span class="range-value" id="angleValue">170°</span></label>
            <input type="range" id="angleInput" min="0" max="360" step="5" value="170">
          </div>
        </div>
      </div>
      
      <div class="control-group">
        <label>Stroke Width <span class="range-value" id="strokeWidthValue">2</span></label>
        <input type="range" id="strokeWidthInput" min="0.5" max="8" step="0.5" value="2">
      </div>
      
      <div class="control-group">
        <label>Duration <span class="range-value" id="durationValue">2.0s</span></label>
        <input type="range" id="durationInput" min="0.5" max="10" step="0.5" value="2">
      </div>
      
      <div class="control-group">
        <label>Overlap <span class="range-value" id="overlapValue">0.02</span></label>
        <input type="range" id="overlapInput" min="0" max="0.5" step="0.01" value="0.02">
      </div>
      
      <div class="control-group">
        <label>Options</label>
        <label class="checkbox-row">
          <input type="checkbox" id="autoPlayInput" checked>
          Auto Play
        </label>
        <label class="checkbox-row" style="margin-top: 6px;">
          <input type="checkbox" id="loopInput">
          Loop
        </label>
      </div>
    </div>
    
    <div class="preview">
      <div class="preview-content">
        <div class="preview-svg-wrap" id="previewContainer"></div>
        <div class="actions">
          <button id="playBtn" class="primary">Play</button>
          <button id="replayBtn">Replay</button>
          <button id="resetBtn">Reset</button>
        </div>
        <p class="info">Powered by @kumailnanji/letters · React + framer-motion</p>
      </div>
    </div>
    
    <div class="export-section" id="exportSection">
      <h2>Export Code</h2>
      <div class="export-tabs">
        <button class="export-tab active" data-tab="react">React Component</button>
        <button class="export-tab" data-tab="umd">UMD Build (Main Site)</button>
      </div>
      
      <div class="export-panel active" id="panel-react">
        <div class="export-tip">Copy this code into your React project. Make sure you have installed <code>@kumailnanji/letters</code>.</div>
        <div class="code-block" id="code-react">
          <button class="copy-btn" data-copy="react">Copy</button>
        </div>
      </div>
      
      <div class="export-panel" id="panel-umd">
        <div class="export-tip">Copy this config object and use with your <code>letters-animation.umd.js</code> build on the main site.</div>
        <div class="code-block" id="code-umd">
          <button class="copy-btn" data-copy="umd">Copy</button>
        </div>
      </div>
    </div>
  </div>

  <script type="module">
    import React from 'react';
    import { createRoot } from 'react-dom/client';
    import { Letters } from '@kumailnanji/letters';

    const container = document.getElementById('previewContainer');
    let root = null;
    let lettersRef = null;

    const gradientDefs = {
      rainbow: {
        stops: [
          { offset: '0%', color: '#ff0000' },
          { offset: '14%', color: '#ff7f00' },
          { offset: '28%', color: '#ffff00' },
          { offset: '43%', color: '#00ff00' },
          { offset: '57%', color: '#0000ff' },
          { offset: '71%', color: '#4b0082' },
          { offset: '85%', color: '#9400d3' },
          { offset: '100%', color: '#ff0000' }
        ]
      },
      sunset: {
        stops: [
          { offset: '0%', color: '#ff6b6b' },
          { offset: '33%', color: '#feca57' },
          { offset: '66%', color: '#ff9ff3' },
          { offset: '100%', color: '#54a0ff' }
        ]
      },
      ocean: {
        stops: [
          { offset: '0%', color: '#00d2d3' },
          { offset: '50%', color: '#5f27cd' },
          { offset: '100%', color: '#341f97' }
        ]
      },
      fire: {
        stops: [
          { offset: '0%', color: '#ff9f43' },
          { offset: '50%', color: '#ee5a24' },
          { offset: '100%', color: '#c44569' }
        ]
      },
      neon: {
        stops: [
          { offset: '0%', color: '#39ff14' },
          { offset: '50%', color: '#00ffff' },
          { offset: '100%', color: '#ff00ff' }
        ]
      },
      gold: {
        stops: [
          { offset: '0%', color: '#f39c12' },
          { offset: '50%', color: '#f1c40f' },
          { offset: '100%', color: '#e67e22' }
        ]
      },
      aurora: {
        stops: [
          { offset: '0%', color: '#00b894' },
          { offset: '25%', color: '#0984e3' },
          { offset: '50%', color: '#6c5ce7' },
          { offset: '75%', color: '#fd79a8' },
          { offset: '100%', color: '#ffeaa7' }
        ]
      },
      berry: {
        stops: [
          { offset: '0%', color: '#e84393' },
          { offset: '50%', color: '#a29bfe' },
          { offset: '100%', color: '#74b9ff' }
        ]
      },
      forest: {
        stops: [
          { offset: '0%', color: '#2ecc71' },
          { offset: '50%', color: '#1abc9c' },
          { offset: '100%', color: '#3498db' }
        ]
      },
      candy: {
        stops: [
          { offset: '0%', color: '#ff9ff3' },
          { offset: '33%', color: '#f368e0' },
          { offset: '66%', color: '#ff6b6b' },
          { offset: '100%', color: '#feca57' }
        ]
      },
      midnight: {
        stops: [
          { offset: '0%', color: '#2c3e50' },
          { offset: '50%', color: '#34495e' },
          { offset: '100%', color: '#8e44ad' }
        ]
      },
      cherry: {
        stops: [
          { offset: '0%', color: '#eb4d4b' },
          { offset: '50%', color: '#f9ca24' },
          { offset: '100%', color: '#f0932b' }
        ]
      },
      cyan: {
        stops: [
          { offset: '0%', color: '#00ffff' },
          { offset: '100%', color: '#00cccc' }
        ]
      },
      magenta: {
        stops: [
          { offset: '0%', color: '#ff00ff' },
          { offset: '100%', color: '#cc00cc' }
        ]
      },
      lime: {
        stops: [
          { offset: '0%', color: '#39ff14' },
          { offset: '100%', color: '#2ecc71' }
        ]
      },
      violet: {
        stops: [
          { offset: '0%', color: '#8e44ad' },
          { offset: '100%', color: '#9b59b6' }
        ]
      }
    };

    const state = {
      text: 'Hello',
      variant: 'simple',
      colorMode: 'solid',
      solidColor: '#ffffff',
      gradientPreset: 'rainbow',
      customGradient: {
        type: 'linear',
        color1: '#00ffff',
        color2: '#00cccc',
        angle: 170
      },
      strokeWidth: 2,
      duration: 2,
      overlap: 0.02,
      autoPlay: true,
      loop: false
    };

    function createGradientSvgDefs(presetKey, custom) {
      if (custom) {
        const { type, color1, color2, angle } = custom;
        if (type === 'radial') {
          return React.createElement('radialGradient', {
            id: 'letters-gradient',
            cx: '50%', cy: '50%', r: '50%', fx: '50%', fy: '50%'
          }, [
            React.createElement('stop', { key: 0, offset: '0%', stopColor: color1 }),
            React.createElement('stop', { key: 1, offset: '100%', stopColor: color2 })
          ]);
        }
        return React.createElement('linearGradient', {
          id: 'letters-gradient',
          x1: '0%', y1: '0%', x2: '100%', y2: '0%',
          gradientUnits: 'userSpaceOnUse',
          gradientTransform: `rotate(${angle}, 0.5, 0.5)`
        }, [
          React.createElement('stop', { key: 0, offset: '0%', stopColor: color1 }),
          React.createElement('stop', { key: 1, offset: '100%', stopColor: color2 })
        ]);
      }
      const def = gradientDefs[presetKey];
      if (!def) return null;
      return React.createElement('linearGradient', {
        id: 'letters-gradient',
        x1: '0%', y1: '0%', x2: '100%', y2: '0%',
        gradientUnits: 'userSpaceOnUse'
      }, def.stops.map((stop, i) =>
        React.createElement('stop', { key: i, offset: stop.offset, stopColor: stop.color })
      ));
    }

    function render() {
      if (!root) {
        root = createRoot(container);
      }
      
      const isCustomGradient = state.colorMode === 'custom';
      const isPresetGradient = state.colorMode !== 'solid' && state.colorMode !== 'custom';
      const isGradient = isCustomGradient || isPresetGradient;
      const color = isGradient ? 'url(#letters-gradient)' : state.solidColor;
      const svgDefs = isCustomGradient 
        ? createGradientSvgDefs(null, state.customGradient)
        : isPresetGradient 
          ? createGradientSvgDefs(state.gradientPreset)
          : null;
      
      root.render(
        React.createElement('div', { style: { width: '100%', height: '100%' } },
          React.createElement(Letters, {
            key: `${state.text}-${state.variant}-${state.duration}-${state.overlap}-${state.colorMode}-${state.gradientPreset}-${state.customGradient.color1}-${state.customGradient.color2}-${state.customGradient.angle}`,
            ref: (ref) => { lettersRef = ref; },
            text: state.text,
            variant: state.variant,
            strokeWidth: state.strokeWidth,
            color: color,
            autoPlay: state.autoPlay,
            loop: state.loop,
            overlap: state.overlap,
            animation: {
              type: 'tween',
              duration: state.duration,
              ease: 'easeInOut'
            },
            svgDefs: svgDefs,
            style: { width: '100%', height: '100%' }
          })
        )
      );
    }

    render();

    // Text
    document.getElementById('textInput').addEventListener('input', (e) => {
      state.text = e.target.value || ' ';
      render();
    });

    // Variant
    document.getElementById('variantSelect').addEventListener('click', (e) => {
      if (e.target.tagName === 'BUTTON') {
        document.querySelectorAll('#variantSelect button').forEach(btn => btn.classList.remove('active'));
        e.target.classList.add('active');
        state.variant = e.target.dataset.variant;
        render();
      }
    });

    // Color Mode
    document.getElementById('modeSelect').addEventListener('click', (e) => {
      if (e.target.tagName === 'BUTTON') {
        document.querySelectorAll('#modeSelect button').forEach(btn => btn.classList.remove('active'));
        e.target.classList.add('active');
        state.colorMode = e.target.dataset.mode;
        
        // Hide all gradient-related controls first
        document.getElementById('solidColorWrap').style.display = 'none';
        document.getElementById('gradientPresetsWrap').style.display = 'none';
        document.getElementById('customGradientWrap').style.display = 'none';
        
        if (state.colorMode === 'solid') {
          document.getElementById('solidColorWrap').style.display = 'flex';
        } else if (state.colorMode === 'custom') {
          document.getElementById('customGradientWrap').style.display = 'flex';
        } else {
          document.getElementById('gradientPresetsWrap').style.display = 'flex';
          // Map mode to preset if not already matching
          if (gradientDefs[state.colorMode]) {
            state.gradientPreset = state.colorMode;
            document.querySelectorAll('.gradient-preset').forEach(p => p.classList.remove('active'));
            document.querySelector(`.gradient-preset[data-preset="${state.colorMode}"]`)?.classList.add('active');
          }
        }
        render();
      }
    });

    // Solid Color
    document.getElementById('colorInput').addEventListener('input', (e) => {
      state.solidColor = e.target.value;
      render();
    });

    // Gradient Presets
    document.getElementById('gradientPresets').addEventListener('click', (e) => {
      const preset = e.target.closest('.gradient-preset');
      if (!preset) return;
      document.querySelectorAll('.gradient-preset').forEach(p => p.classList.remove('active'));
      preset.classList.add('active');
      state.gradientPreset = preset.dataset.preset;
      render();
    });

    // Custom Gradient
    document.getElementById('customColor1').addEventListener('input', (e) => {
      state.customGradient.color1 = e.target.value;
      render();
    });
    document.getElementById('customColor2').addEventListener('input', (e) => {
      state.customGradient.color2 = e.target.value;
      render();
    });
    document.getElementById('angleInput').addEventListener('input', (e) => {
      state.customGradient.angle = parseInt(e.target.value);
      document.getElementById('angleValue').textContent = state.customGradient.angle + '°';
      render();
    });
    document.getElementById('gradientTypeSelect').addEventListener('click', (e) => {
      if (e.target.tagName === 'BUTTON') {
        document.querySelectorAll('#gradientTypeSelect button').forEach(btn => btn.classList.remove('active'));
        e.target.classList.add('active');
        state.customGradient.type = e.target.dataset.type;
        const angleRow = document.getElementById('angleRow');
        if (angleRow) {
          angleRow.style.display = state.customGradient.type === 'radial' ? 'none' : 'flex';
        }
        render();
      }
    });

    // Sliders
    document.getElementById('strokeWidthInput').addEventListener('input', (e) => {
      state.strokeWidth = parseFloat(e.target.value);
      document.getElementById('strokeWidthValue').textContent = state.strokeWidth;
      render();
    });

    document.getElementById('durationInput').addEventListener('input', (e) => {
      state.duration = parseFloat(e.target.value);
      document.getElementById('durationValue').textContent = state.duration + 's';
      render();
    });

    document.getElementById('overlapInput').addEventListener('input', (e) => {
      state.overlap = parseFloat(e.target.value);
      document.getElementById('overlapValue').textContent = state.overlap;
      render();
    });

    document.getElementById('autoPlayInput').addEventListener('change', (e) => {
      state.autoPlay = e.target.checked;
      render();
    });

    document.getElementById('loopInput').addEventListener('change', (e) => {
      state.loop = e.target.checked;
      render();
    });

    // Actions
    document.getElementById('playBtn').addEventListener('click', () => {
      if (lettersRef && lettersRef.play) lettersRef.play();
    });

    document.getElementById('replayBtn').addEventListener('click', () => {
      if (lettersRef && lettersRef.replay) lettersRef.replay();
    });

    document.getElementById('resetBtn').addEventListener('click', () => {
      if (lettersRef && lettersRef.reset) lettersRef.reset();
    });

    // ==================== Export Code ====================
    function escapeHtmlForCode(str) {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function generateReactCode() {
      const isGradient = state.colorMode !== 'solid';
      const def = gradientDefs[state.gradientPreset];
      let svgDefsCode = '';
      if (isGradient && def) {
        const stops = def.stops.map(s => `        <stop offset="${s.offset}" stopColor="${s.color}" />`).join('\n');
        svgDefsCode = `
  svgDefs={(
    <linearGradient id="letters-gradient" x1="0%" y1="0%" x2="100%" y2="0%" gradientUnits="userSpaceOnUse">
${stops}
    </linearGradient>
  )}`;
      }
      const color = isGradient ? 'url(#letters-gradient)' : state.solidColor;
      return `import { Letters } from '@kumailnanji/letters';

function MyLetters() {
  return (
    <Letters
      text="${state.text}"
      variant="${state.variant}"
      strokeWidth={${state.strokeWidth}}
      color="${color}"
      autoPlay={${state.autoPlay}}
      loop={${state.loop}}
      overlap={${state.overlap}}
      animation={{
        type: 'tween',
        duration: ${state.duration},
        ease: 'easeInOut'
      }}${svgDefsCode}
    />
  );
}`;
    }

    function generateUmdCode() {
      const isGradient = state.colorMode !== 'solid';
      const def = gradientDefs[state.gradientPreset];
      let gradientConfig = '';
      if (isGradient && def) {
        const stops = def.stops.map(s => `    { offset: '${s.offset}', color: '${s.color}' }`).join(',\n');
        gradientConfig = `\n// Gradient stops (inject via svgDefs prop):\nconst gradientStops = [\n${stops}\n];`;
      }
      const color = isGradient ? 'url(#letters-gradient)' : state.solidColor;
      return `// Config for letters-animation.umd.js
const lettersConfig = {
  text: '${state.text}',
  variant: '${state.variant}',
  strokeWidth: ${state.strokeWidth},
  color: '${color}',
  autoPlay: ${state.autoPlay},
  loop: ${state.loop},
  overlap: ${state.overlap},
  animation: {
    type: 'tween',
    duration: ${state.duration},
    ease: 'easeInOut'
  }${gradientConfig ? ',' + gradientConfig : ''}
};${isGradient ? '\n\n// Then use: window.mountLettersAnimation(container, config.text, config.color, config.strokeWidth)' : ''}`;
    }

    function highlightCode(code) {
      return code
        .replace(/(\/\/.*$)/gm, '<span class="comment">$1</span>')
        .replace(/('(?:[^'\\]|\\.)*')/g, '<span class="string">$1</span>')
        .replace(/(<[^>]+>)/g, '<span class="tag">$1</span>')
        .replace(/\b(true|false|null)\b/g, '<span class="keyword">$1</span>')
        .replace(/\b(import|from|function|return|const|let|var)\b/g, '<span class="keyword">$1</span>')
        .replace(/\b(\d+\.?\d*)\b/g, '<span class="number">$1</span>');
    }

    function updateExport() {
      const reactCode = generateReactCode();
      const umdCode = generateUmdCode();
      document.getElementById('code-react').innerHTML = '<button class="copy-btn" data-copy="react">Copy</button>' + highlightCode(reactCode);
      document.getElementById('code-umd').innerHTML = '<button class="copy-btn" data-copy="umd">Copy</button>' + highlightCode(umdCode);
    }

    // Export tabs
    document.getElementById('exportSection').addEventListener('click', (e) => {
      const tab = e.target.closest('.export-tab');
      if (tab) {
        document.querySelectorAll('.export-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.export-panel').forEach(p => p.classList.remove('active'));
        tab.classList.add('active');
        document.getElementById('panel-' + tab.dataset.tab).classList.add('active');
      }
      const copyBtn = e.target.closest('.copy-btn');
      if (copyBtn) {
        const type = copyBtn.dataset.copy;
        const code = type === 'react' ? generateReactCode() : generateUmdCode();
        navigator.clipboard.writeText(code).then(() => {
          copyBtn.textContent = 'Copied!';
          copyBtn.classList.add('copied');
          setTimeout(() => {
            copyBtn.textContent = 'Copy';
            copyBtn.classList.remove('copied');
          }, 2000);
        });
      }
    });

    // Update export on every parameter change
    const updateExportOnChange = () => { updateExport(); };
    document.getElementById('textInput').addEventListener('input', updateExportOnChange);
    document.getElementById('strokeWidthInput').addEventListener('input', updateExportOnChange);
    document.getElementById('durationInput').addEventListener('input', updateExportOnChange);
    document.getElementById('overlapInput').addEventListener('input', updateExportOnChange);
    document.getElementById('colorInput').addEventListener('input', updateExportOnChange);
    document.getElementById('autoPlayInput').addEventListener('change', updateExportOnChange);
    document.getElementById('loopInput').addEventListener('change', updateExportOnChange);
    document.getElementById('variantSelect').addEventListener('click', updateExportOnChange);
    document.getElementById('modeSelect').addEventListener('click', updateExportOnChange);
    document.getElementById('gradientPresets').addEventListener('click', updateExportOnChange);

    updateExport();
  </script>
</body>
</html>
